# ClipBox local deployment — copied to .env by bootstrap.sh on first boot.
# bootstrap.sh fills every "set by bootstrap" value; edit afterwards if you like,
# then: docker compose -f docker-compose.local.yml up -d

# --- Web interface ---
# user:password pairs. bootstrap generates clip:<random> and writes the password
# to FIRST-LOGIN.txt and /etc/motd.
USERS=clip:set-by-bootstrap
# Signs the session cookie (random, stable across restarts).
SESSION_SECRET=set-by-bootstrap
# LAN address of this box; used for OAuth redirects (upload is optional).
PUBLIC_URL=http://set-by-bootstrap:9443
WEB_PORT=9443
ROOT_PATH=

# --- GPU device access for the ollama/whisper containers (host group ids) ---
RENDER_GID=set-by-bootstrap
VIDEO_GID=set-by-bootstrap

# --- Models (derived from config.yaml by bootstrap.sh; keep them in sync) ---
OLLAMA_TEXT_MODEL=qwen3:14b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
WHISPER_MODEL=large-v3-turbo
WHISPER_LANG=de
WHISPER_THREADS=6
# extra whisper-server flags; drop -fa if flash attention misbehaves on Vulkan
WHISPER_EXTRA_ARGS=-fa

# --- Twitch (optional: Helix metadata; chat replay works without) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Upload OAuth (optional, see main README) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OPERATOR_NAME=
CONTACT_EMAIL=

# No ANTHROPIC_API_KEY: llm.provider is ollama in deploy/local/config.yaml.
