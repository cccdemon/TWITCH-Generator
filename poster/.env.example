# Shared secret; the generator sends it as "Authorization: Bearer <token>".
POSTER_TOKEN=change-me
# adb serial of the phone (adb devices -l)
ADB_SERIAL=ZY22HDBZG8
# Expected logged-in accounts; a post aborts if the app shows another one.
TIKTOK_ACCOUNT=justcallme_deimos
INSTAGRAM_ACCOUNT=justcallmedeimos
# LAN only (Deimoscraft is not exposed). Port 3300 on all interfaces.
PORT=3300
BIND_ADDR=0.0.0.0
# Uploaded videos of finished posts are deleted after this many days.
KEEP_MEDIA_DAYS=7
